# Copia este archivo a .env y llena los valores. NUNCA subas .env al repo.
# Las variables se validan con zod en server/src/config/ al arrancar.

# --- Server ---
NODE_ENV=development
PORT=3001
CLIENT_ORIGIN=http://localhost:5173
TZ=America/Mexico_City

# --- MongoDB ---
MONGODB_URI=mongodb://localhost:27017/fuerza-gym-crm

# --- Auth ---
JWT_SECRET=cambia-esto-por-un-valor-largo-y-aleatorio
JWT_EXPIRES_IN=8h

# --- Anthropic (modelos por agente: PENDIENTES #30) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_ROUTER=claude-haiku-5-5
ANTHROPIC_MODEL_AGENTS=claude-sonnet-5-5

# --- Canal WhatsApp: simulator | meta (ADR-001) ---
WA_PROVIDER=simulator

# --- Meta WhatsApp Cloud API (solo si WA_PROVIDER=meta; PENDIENTES #12) ---
META_WA_API_VERSION=
META_WA_PHONE_NUMBER_ID=
META_WA_BUSINESS_ACCOUNT_ID=
META_WA_ACCESS_TOKEN=
META_WA_APP_SECRET=
META_WA_VERIFY_TOKEN=

# --- Google Calendar (método de acceso: PENDIENTES #14) ---
GOOGLE_CALENDAR_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=

# --- Transcripción de voz (proveedor: PENDIENTES #16) ---
STT_PROVIDER=
STT_API_KEY=

# --- Almacenamiento de media/comprobantes: gridfs | s3 (PENDIENTES #17) ---
STORAGE_PROVIDER=gridfs
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_ENDPOINT=

# --- Email transaccional (proveedor: PENDIENTES #18) ---
EMAIL_PROVIDER=
EMAIL_API_KEY=
EMAIL_FROM=
