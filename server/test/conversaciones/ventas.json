[
  {
    "id": "califica-objetivo-y-pregunta-horario",
    "description": "El lead dice su objetivo: lo registra y pregunta solo el horario, sin presionar",
    "messages": [
      {
        "role": "assistant",
        "content": "¡Hola Ana! Soy Sofía, asistente virtual de Fuerza Gym. ¿Qué buscas lograr?"
      },
      {
        "role": "user",
        "content": "Quiero ganar masa muscular"
      }
    ],
    "expect": {
      "action": "REGISTRAR_DATOS",
      "handoffTarget": null,
      "escalation": null,
      "replyNull": false,
      "mustMatch": [
        "horario"
      ],
      "mustNotMatch": [
        "(?<!no )(te (doy|ofrezco|hago|aplico)|hay|tenemos|ofrecemos|contamos con|puedo (darte|ofrecerte)) (un |una |algún |alguna )?(descuento|rebaja|promoci[oó]n|oferta)|tienes .{0,20}% de descuento",
        "\\d+\\s?%",
        "garantiz",
        "\\bedad\\b"
      ]
    }
  },
