{
  "permissions": {
    "allow": [
      "Bash(npm test)",
      "PowerShell(npm test)",
      "Bash(npm test -w server)",
      "PowerShell(npm test -w server)",
      "Bash(npm test -w client)",
      "PowerShell(npm test -w client)",
      "Bash(npm run test)",
      "PowerShell(npm run test)",
      "Bash(npm run test -w server)",
      "PowerShell(npm run test -w server)",
      "Bash(npm run dev)",
      "PowerShell(npm run dev)",
      "Bash(npm run dev -w server)",
      "PowerShell(npm run dev -w server)",
      "Bash(npm run dev -w client)",
      "PowerShell(npm run dev -w client)",
      "Bash(npm run build)",
      "PowerShell(npm run build)",
      "Bash(npm run build -w client)",
      "PowerShell(npm run build -w client)",
      "Bash(npm run lint)",
      "PowerShell(npm run lint)",
      "Bash(node --test .claude/hooks/guard.test.mjs)",
      "PowerShell(node --test .claude/hooks/guard.test.mjs)",
      "Bash(git status)",
      "PowerShell(git status)",
      "Bash(git status *)",
      "PowerShell(git status *)",
      "Bash(git diff)",
      "PowerShell(git diff)",
      "Bash(git diff *)",
      "PowerShell(git diff *)",
      "Bash(git log)",
      "PowerShell(git log)",
      "Bash(git log *)",
      "PowerShell(git log *)",
      "Bash(git show)",
      "PowerShell(git show)",
      "Bash(git show *)",
      "PowerShell(git show *)",
      "Bash(git blame *)",
      "PowerShell(git blame *)",
      "Bash(git ls-files)",
      "PowerShell(git ls-files)",
      "Bash(git ls-files *)",
      "PowerShell(git ls-files *)",
      "Bash(git rev-parse *)",
      "PowerShell(git rev-parse *)"
    ],
    "ask": [
      "Bash(git add *)",
      "PowerShell(git add *)",
      "Bash(git commit *)",
      "PowerShell(git commit *)",
      "Bash(npm install)",
      "PowerShell(npm install)",
      "Bash(npm install *)",
      "PowerShell(npm install *)",
      "Bash(npm i)",
      "PowerShell(npm i)",
      "Bash(npm i *)",
      "PowerShell(npm i *)",
      "Bash(npm ci)",
      "PowerShell(npm ci)",
      "Bash(npm ci *)",
      "PowerShell(npm ci *)",
      "Bash(npm uninstall *)",
      "PowerShell(npm uninstall *)",
      "Bash(npm update *)",
      "PowerShell(npm update *)",
      "Bash(npm exec *)",
      "PowerShell(npm exec *)",
      "Bash(npx *)",
      "PowerShell(npx *)",
      "Bash(npm run seed)",
      "PowerShell(npm run seed)",
      "Bash(npm run seed *)",
      "PowerShell(npm run seed *)"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Read(**/.env.production)",
      "Read(**/.env.development)",
      "Read(**/.env.test)",
      "Read(**/.env.staging)",
      "Read(**/.env.prod)",
      "Read(**/.env.dev)",
      "Edit(**/.env)",
      "Edit(**/.env.local)",
      "Edit(**/.env.*.local)",
      "Edit(**/.env.production)",
      "Edit(**/.env.development)",
      "Edit(**/.env.test)",
      "Edit(**/.env.staging)",
      "Edit(**/.env.prod)",
      "Edit(**/.env.dev)",
      "Bash(git push)",
      "Bash(git push *)",
      "Bash(git * push)",
      "Bash(git * push *)",
      "PowerShell(git push)",
      "PowerShell(git push *)",
      "PowerShell(git * push)",
      "PowerShell(git * push *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Read|Edit|MultiEdit|Write|NotebookEdit|Grep|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard.mjs\"",
            "timeout": 10,
            "onFailure": "block"
          }
        ]
      }
    ]
  }
}
